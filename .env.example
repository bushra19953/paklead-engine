# ============================================================
# PakLead Engine — environment contract (TRD §3).
# Placeholders only. Copy to `.env` and fill in real values.
# NEVER commit `.env`. Secrets load from env only (SHR-16).
# ============================================================

# --- Reddit (official API) — register a free app at reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=PakLeadEngine/1.0 by <your-reddit-username>

# --- Facebook adapter ---
# api | cli_adapter | manual_import  (browser_optin is a documented opt-in
# path; see FB_BROWSER_OPTIN — read the account-risk warning in README)
FB_ACCESS_MODE=cli_adapter
FB_BROWSER_OPTIN=false
# Path to a CSV/JSON file for manual_import mode (adapter c)
# FB_IMPORT_FILE=./data/fb_import.csv

# --- Alerts ---
ALERT_WEBHOOK_URL=https://your-webhook.example/hot-leads
# Bearer token gating operator API writes (POST /sync/bulk-upsert, POST /sync/hide-samples)
DASHBOARD_API_TOKEN=change-me-to-a-long-random-secret

# --- Storage + schedule ---
DB_PATH=./data/pak_leads.db
CHROMA_PATH=./data/chroma
RUN_TIME=0 6 * * *

# --- Kill switch (SHR-12): true stops ALL collection immediately ---
KILL_SWITCH=false
